{
  "manifest_version": 3,
  "name": "Cookie Clicker Grandmaster",
  "version": "6.1.7",
  "description": "Autoplay for Cookie Clicker aimed at 100% achievements: payback optimizer, timed golden sugar lumps, predictive Grimoire, garden planner, tested stock market, achievement hunters, growth-based auto-ascend.",
  "browser_specific_settings": {
    "gecko": { "id": "cookie-clicker-grandmaster@local", "strict_min_version": "128.0" }
  },
  "host_permissions": ["https://orteil.dashnet.org/*"],
  "content_scripts": [
    {
      "matches": ["https://orteil.dashnet.org/cookieclicker/*", "https://orteil.dashnet.org/cookieclicker"],
      "js": ["src/core.js", "src/economy.js", "src/lumps.js", "src/minigames.js", "src/hunts.js", "src/meta.js", "src/graphs.js", "src/ui.js"],
      "run_at": "document_idle",
      "world": "MAIN"
    }
  ]
}
